{
  "name": "@lvlte/rationalize",
  "version": "1.1.0",
  "description": "Represent a floating point number as a rational number",
  "license": "MIT",
  "author": "Eric Lavault <lvlte.code@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvlte/rationalize.git"
  },
  "bugs": {
    "url": "https://github.com/lvlte/rationalize/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "unpkg": "./dist/umd/rationalize.min.js",
  "jsdelivr": "./dist/umd/rationalize.js",
  "engines": {
    "node": ">=18.20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "tscheck": "tsc --noEmit && tsc -p ./test/tsconfig.json",
    "pretest": "npm run tscheck",
    "test": "jest --verbose",
    "prebuild": "rm -Rf dist && mkdir dist",
    "build": "tsdown",
    "postbuild": "(echo { \"type\": \"commonjs\" }) > ./dist/cjs/package.json",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "rational",
    "number",
    "fraction",
    "float64",
    "integer",
    "tolerance",
    "precision",
    "IEEE 754",
    "math"
  ],
  "devDependencies": {
    "@lvlte/tsconfig": "^1.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "tsdown": "^0.23.0",
    "twofloat": "^0.3.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@lvlte/ulp": "^1.5.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "unrs-resolver": true
  },
  "overrides": {
    "test-exclude": {
      "glob": "^13.0.6"
    }
  }
}
