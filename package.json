{
  "name": "@lvlte/rationalize",
  "version": "1.0.5",
  "description": "Represent a floating point number as a rational number",
  "license": "MIT",
  "author": "Eric Lavault <lvlte.code@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvlte/rationalize.git"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "engines": {
    "node": ">=18.20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "jest --verbose",
    "prebuild": "rm -Rf dist && mkdir dist",
    "build": "tsc && tsc -p tsconfig-cjs.json",
    "postbuild": "(echo { && echo   \"type\": \"commonjs\" && echo }) > ./dist/cjs/package.json",
    "prepublishOnly": "npm test && npm run build && tsc --emitDeclarationOnly true --removeComments false && tsc -p tsconfig-cjs.json --emitDeclarationOnly true --removeComments false"
  },
  "keywords": [
    "rational",
    "number",
    "fraction",
    "float64",
    "integer",
    "tolerance",
    "precision",
    "IEEE754"
  ],
  "devDependencies": {
    "@lvlte/tsconfig": "^1.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "twofloat": "^0.3.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@lvlte/ulp": "^1.3.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "unrs-resolver": true
  },
  "overrides": {
    "test-exclude": {
      "glob": "^13.0.6"
    }
  }
}
